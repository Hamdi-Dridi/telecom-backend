# Copy to .env for local use, or set these as environment variables in your
# hosting platform's dashboard (Render/Railway/etc). None are required for
# local development — the app falls back to safe dev defaults + SQLite.

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=false

# Comma-separated. The hostname of your deployed backend, e.g.:
ALLOWED_HOSTS=my-backend.onrender.com

# Comma-separated. The URL(s) of your deployed frontend (Vercel), e.g.:
# https://my-app.vercel.app,https://my-app-git-main-me.vercel.app
CORS_ALLOWED_ORIGINS=https://my-app.vercel.app

# Provided automatically by Render/Railway once you attach a Postgres addon —
# you normally don't set this by hand.
# DATABASE_URL=postgres://user:password@host:5432/dbname
